---
const path = Astro.url.pathname;
const navItems = [
	{ href: '/', label: 'Home', active: path === '/' },
	{
		href: '/projects',
		label: 'Projects',
		active: path.startsWith('/projects'),
	},
	{ href: '/blog', label: 'Blog', active: path.startsWith('/blog') },
	{ href: '/misc', label: 'Misc', active: path.startsWith('/misc') },
];
---

<header class="site-header">
	<nav class="shell nav" aria-label="Primary navigation">
		<ul>
			{
				navItems.map((item) => (
					<li>
						<a href={item.href} aria-current={item.active ? 'page' : undefined}>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		border-bottom: 1px solid color-mix(in srgb, var(--line) 72%, transparent);
		background: color-mix(in srgb, var(--paper) 94%, transparent);
		backdrop-filter: blur(10px);
	}

	.nav {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		height: 4.5rem;
	}

	ul {
		display: flex;
		gap: clamp(1.15rem, 4vw, 2.4rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li {
		display: flex;
	}

	li a {
		position: relative;
		padding: 0.35rem 0;
		color: var(--ink);
		font-size: 0.86rem;
		text-decoration: none;
	}

	li a::after {
		position: absolute;
		bottom: 0;
		left: 50%;
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: var(--accent);
		content: '';
		opacity: 0;
		transform: translateX(-50%);
	}

	li a:hover {
		color: var(--accent);
	}

	li a[aria-current='page']::after {
		opacity: 1;
	}

	@media (max-width: 30rem) {
		.nav {
			height: 4rem;
		}

		ul {
			gap: 1rem;
		}

		li a {
			font-size: 0.78rem;
		}
	}
</style>
