---
import { SITE } from '../lib/site';

const path = Astro.url.pathname;
const section = (href: string) => path === href || path.startsWith(`${href}/`);
const items = [
	{ href: '/writing', label: 'writing' },
	{ href: '/projects', label: 'projects' },
	{ href: '/travels', label: 'travels' },
];
// Exactly the section's own page gets aria-current="page"; deeper pages are
// marked as being inside the section.
const current = (href: string) =>
	path.replace(/\/$/, '') === href
		? 'page'
		: section(href)
			? 'true'
			: undefined;
---

<header class="site-header">
	<a class="site-name" href="/" aria-current={path === '/' ? 'page' : undefined}
		>James Zheng</a
	>
	<nav aria-label="Main">
		<ul class="plain-list">
			{
				items.map(({ href, label }) => (
					<li>
						<a href={href} aria-current={current(href)}>
							{label}
						</a>
					</li>
				))
			}
			<li>
				<a href={SITE.resume} data-umami-event="resume-click">resume</a>
			</li>
		</ul>
	</nav>
</header>

<style>
	.site-header {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px;
	}

	.site-name {
		font-size: 16px;
		font-weight: 600;
		text-decoration: none;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 20px;
		font-family: var(--mono);
		font-size: 13px;
	}

	a[aria-current] {
		font-weight: 500;
		text-decoration: none;
	}
</style>
