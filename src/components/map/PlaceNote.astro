---
// A note in a place card: a few sentences that can hold `[text](href)` links,
// plus an optional link line underneath. `caption` is a photo's note, set
// under the photo as its figcaption; `body` is the place's own note.
import { isExternal, noteParts, type Link } from '../../lib/map/places';

interface Props {
	id: string;
	variant: 'caption' | 'body';
	note?: string;
	link?: Link;
}

const { id, variant, note, link } = Astro.props;
const Tag = variant === 'caption' ? 'figcaption' : 'div';
const rel = (href: string) => (isExternal(href) ? 'external' : undefined);
---

<Tag class:list={['place-note', variant]} id={id}>
	{
		note && (
			<p>
				{noteParts(note).map(({ text, href }) =>
					href ? (
						<a href={href} rel={rel(href)}>
							{text}
						</a>
					) : (
						text
					),
				)}
			</p>
		)
	}
	{
		link && (
			<a class="note-link" href={link.href} rel={rel(link.href)}>
				{link.label}
				<span aria-hidden="true"> →</span>
			</a>
		)
	}
</Tag>

<style>
	.place-note {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		overflow-wrap: anywhere;
	}

	.body {
		gap: 8px;
		color: var(--ink-2);
		font-size: 14px;
		line-height: 1.5;
	}

	/* Under the photo, ruled off from the card body. */
	.caption {
		gap: 6px;
		margin: 0 16px;
		padding: 10px 0;
		border-bottom: 1px solid var(--line);
		color: var(--muted);
		font-size: 13px;
		line-height: 1.45;
	}

	.note-link {
		font-weight: 500;
		text-decoration: none;
	}

	.note-link:hover {
		text-decoration: underline;
	}
</style>
