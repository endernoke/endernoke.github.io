---
import { Image } from 'astro:assets';
import WorldOutline from './WorldOutline.astro';

type PlacePhoto = {
	image: ImageMetadata;
	alt: string;
	note?: string;
};

type PhotoMetadata = {
	alt?: string;
	note?: string;
};

type PlaceDefinition = {
	id: string;
	name: string;
	coordinates: {
		latitude: number;
		longitude: number;
	};
	note?: string;
};

type Place = PlaceDefinition & {
	photos: PlacePhoto[];
};

// Add images to src/assets/travel/<location-id>/. Numeric filename prefixes control their order.
// Optional alt text and notes live beside them in photos.json, keyed by the full image filename.
const travelImages = import.meta.glob<ImageMetadata>(
	'../assets/travel/*/*.{avif,gif,jpeg,jpg,png,svg,webp}',
	{ eager: true, import: 'default' },
);
const travelMetadata = import.meta.glob<Record<string, PhotoMetadata>>(
	'../assets/travel/*/photos.json',
	{ eager: true, import: 'default' },
);

const filenameFromPath = (path: string) => path.split('/').at(-1) ?? path;

const descriptionFromFilename = (filename: string) =>
	filename
		.replace(/\.[^.]+$/, '')
		.replace(/^\d+[-_ ]*/, '')
		.replace(/[-_]+/g, ' ');

const positionFromCoordinates = ({
	latitude,
	longitude,
}: PlaceDefinition['coordinates']) => {
	if (latitude < -90 || latitude > 90 || longitude < -180 || longitude > 180) {
		throw new RangeError(`Invalid map coordinates: ${latitude}, ${longitude}`);
	}

	const x = ((longitude + 180) / 360) * 100;
	const y = ((90 - latitude) / 180) * 100;
	return `--marker-x: ${x}%; --marker-y: ${y}%;`;
};

const loadPhotos = (place: PlaceDefinition): PlacePhoto[] => {
	const directory = `../assets/travel/${place.id}/`;
	const photoMetadata = travelMetadata[`${directory}photos.json`] ?? {};

	return Object.entries(travelImages)
		.filter(([path]) => path.startsWith(directory))
		.sort(([a], [b]) =>
			filenameFromPath(a).localeCompare(filenameFromPath(b), undefined, {
				numeric: true,
				sensitivity: 'base',
			}),
		)
		.map(([path, image]) => {
			const filename = filenameFromPath(path);
			const metadata = photoMetadata[filename];

			return {
				image,
				alt:
					metadata?.alt ??
					`${place.name}: ${descriptionFromFilename(filename)}`,
				note: metadata?.note,
			};
		});
};

const placeDefinitions: PlaceDefinition[] = [
	{
		id: 'hong-kong',
		name: 'Hong Kong',
		coordinates: { latitude: 22.3193, longitude: 114.1694 },
	},
	{
		id: 'shenzhen',
		name: 'Shenzhen',
		coordinates: { latitude: 22.5431, longitude: 114.0579 },
	},
	{
		id: 'xian',
		name: "Xi'an",
		coordinates: { latitude: 34.3416, longitude: 108.9398 },
	},
	{
		id: 'beijing',
		name: 'Beijing',
		coordinates: { latitude: 39.9042, longitude: 116.4074 },
		note: 'Climbed the wall',
	},
	{
		id: 'nanjing',
		name: 'Nanjing',
		coordinates: { latitude: 32.0603, longitude: 118.7969 },
	},
	{
		id: 'chongqing',
		name: 'Chongqing',
		coordinates: { latitude: 29.563, longitude: 106.5516 },
		note: 'Almost had hotpot in a air shelter',
	},
	{
		id: 'tengchong',
		name: 'Tengchong',
		coordinates: { latitude: 25.0202, longitude: 98.4973 },
		note: 'A week of hiking and rotting in the mountains I guess',
	},
	{
		id: 'singapore',
		name: 'Singapore',
		coordinates: { latitude: 1.3521, longitude: 103.8198 },
		note: 'Spoke at Young Founders School 2025 Gala',
	},
	{
		id: 'sydney',
		name: 'Sydney',
		coordinates: { latitude: -33.8688, longitude: 151.2093 },
		note: 'Team HK, Australasian Economics Olympiad 2025',
	},
	{
		id: 'berlin',
		name: 'Berlin',
		coordinates: { latitude: 52.52, longitude: 13.405 },
	},
	{
		id: 'salzburg',
		name: 'Salzburg',
		coordinates: { latitude: 47.8095, longitude: 13.055 },
		note: 'Hiking in the early morning.',
	},
	{
		id: 'nyc',
		name: 'New York',
		coordinates: { latitude: 40.7128, longitude: -74.006 },
		note: 'I visited the U.S. multiple times as a child',
	},
	{
		id: 'cambridge-ma',
		name: 'Cambridge',
		coordinates: { latitude: 42.3736, longitude: -71.1097 },
		note: 'Chilling inside the MIT campus',
	},
	{
		id: 'san-francisco',
		name: 'San Francisco',
		coordinates: { latitude: 37.7749, longitude: -122.4194 },
		note: 'Visited 10 years ago. Will I be back?',
	},
];

const places: Place[] = placeDefinitions.map((place) => ({
	...place,
	photos: loadPhotos(place),
}));

const placeOptions = [...places].sort((a, b) => a.name.localeCompare(b.name));
---

<div class="map-component">
	<div class="map-toolbar">
		<p class="map-instructions" id="map-instructions">
			Choose a marker or use the location list.
		</p>
		<label class="place-picker">
			<span>Jump to</span>
			<select data-place-picker>
				<option value="">Choose a place</option>
				{
					placeOptions.map((place) => (
						<option value={`${place.id}-popup`}>{place.name}</option>
					))
				}
			</select>
		</label>
	</div>
	<div class="map-frame" aria-describedby="map-instructions">
		<WorldOutline />
		<svg class="cluster-lines" data-cluster-lines aria-hidden="true"></svg>
		<div class="cluster-buttons" data-cluster-buttons></div>

		{
			places.map((place) => (
				<div
					class="place"
					style={positionFromCoordinates(place.coordinates)}
					data-latitude={place.coordinates.latitude}
					data-longitude={place.coordinates.longitude}
				>
					<button
						class="marker"
						type="button"
						data-place-name={place.name}
						aria-label={`Show photos from ${place.name}`}
						aria-expanded="false"
						aria-controls={`${place.id}-popup`}
					>
						<span aria-hidden="true" />
					</button>
					<article
						class="place-card"
						id={`${place.id}-popup`}
						aria-labelledby={`${place.id}-title`}
						data-carousel
						data-index="0"
						tabindex="-1"
						hidden
					>
						<header class="place-card-header">
							<h3 id={`${place.id}-title`}>{place.name}</h3>
							{place.photos.length > 1 && (
								<span class="slide-count" aria-live="polite" aria-atomic="true">
									1 / {place.photos.length}
								</span>
							)}
						</header>
						<div class="slides" aria-labelledby={`${place.id}-title`}>
							{place.photos.map((item, index) => (
								<figure
									class="slide"
									role="group"
									aria-roledescription="slide"
									aria-label={`${index + 1} of ${place.photos.length}`}
									hidden={index !== 0}
								>
									<Image
										src={item.image}
										alt={item.alt}
										width={640}
										widths={[320, 480, 640, 960]}
										sizes="(max-width: 42rem) calc(100vw - 2rem), 304px"
										quality={75}
										loading="lazy"
									/>
									{item.note && <figcaption>{item.note}</figcaption>}
								</figure>
							))}
							{place.photos.length > 1 && (
								<nav
									class="carousel-controls"
									aria-label={`${place.name} photo controls`}
								>
									<button
										class="carousel-button"
										type="button"
										data-carousel-previous
										aria-label={`Previous ${place.name} photo`}
									>
										<svg viewBox="0 0 16 16" aria-hidden="true">
											<path d="m10 3-5 5 5 5" />
										</svg>
									</button>
									<button
										class="carousel-button"
										type="button"
										data-carousel-next
										aria-label={`Next ${place.name} photo`}
									>
										<svg viewBox="0 0 16 16" aria-hidden="true">
											<path d="m6 3 5 5-5 5" />
										</svg>
									</button>
								</nav>
							)}
						</div>
						{place.photos.length === 0 && place.note && (
							<p class="place-note">{place.note}</p>
						)}
					</article>
				</div>
			))
		}
	</div>
	<p class="map-caption">
		Map outline from <a href="https://www.naturalearthdata.com/" rel="external"
			>Natural Earth</a
		>.
	</p>
</div>

<script>
	const markers = document.querySelectorAll<HTMLButtonElement>('.marker');
	const carousels = document.querySelectorAll<HTMLElement>('[data-carousel]');
	const placePicker = document.querySelector<HTMLSelectElement>(
		'[data-place-picker]',
	);
	const mapFrame = document.querySelector<HTMLElement>('.map-frame');
	const clusterButtons = document.querySelector<HTMLElement>(
		'[data-cluster-buttons]',
	);
	const clusterLines = document.querySelector<SVGSVGElement>(
		'[data-cluster-lines]',
	);

	type MarkerPoint = {
		marker: HTMLButtonElement;
		place: HTMLElement;
		x: number;
		y: number;
	};

	type MapCluster = {
		members: MarkerPoint[];
		button: HTMLButtonElement;
		lines: SVGLineElement[];
		names: string;
		x: number;
		y: number;
		expanded: boolean;
	};

	let clusters: MapCluster[] = [];
	const markerClusters = new Map<HTMLButtonElement, MapCluster>();

	const normalizeSlideIndex = (requestedIndex: number, slideCount: number) =>
		(requestedIndex + slideCount) % slideCount;

	const requestSlide = (
		carousel: HTMLElement,
		requestedIndex: number,
		priority: 'high' | 'low',
	) => {
		const slides = carousel.querySelectorAll<HTMLElement>('.slide');
		if (slides.length === 0) return;

		const index = normalizeSlideIndex(requestedIndex, slides.length);
		const image = slides[index].querySelector<HTMLImageElement>('img');
		if (!image) return;

		image.fetchPriority = priority;
		image.loading = 'eager';
	};

	const warmSlides = (carousel: HTMLElement, activeIndex: number) => {
		const slideCount = carousel.querySelectorAll('.slide').length;
		requestSlide(carousel, activeIndex, 'high');
		if (slideCount > 1) {
			requestSlide(carousel, activeIndex - 1, 'low');
			requestSlide(carousel, activeIndex + 1, 'low');
		}
	};

	const showSlide = (
		carousel: HTMLElement,
		requestedIndex: number,
		preload = true,
	) => {
		const slides = carousel.querySelectorAll<HTMLElement>('.slide');
		if (slides.length === 0) return;

		const index = normalizeSlideIndex(requestedIndex, slides.length);
		if (preload) warmSlides(carousel, index);
		slides.forEach((slide, slideIndex) => {
			slide.hidden = slideIndex !== index;
		});
		carousel.dataset.index = String(index);

		const count = carousel.querySelector<HTMLElement>('.slide-count');
		if (count) count.textContent = `${index + 1} / ${slides.length}`;
	};

	carousels.forEach((carousel) => {
		carousel
			.querySelector<HTMLButtonElement>('[data-carousel-previous]')
			?.addEventListener('click', () => {
				showSlide(carousel, Number(carousel.dataset.index ?? 0) - 1);
			});

		carousel
			.querySelector<HTMLButtonElement>('[data-carousel-next]')
			?.addEventListener('click', () => {
				showSlide(carousel, Number(carousel.dataset.index ?? 0) + 1);
			});

		carousel.addEventListener('keydown', (event) => {
			if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
			event.preventDefault();
			const direction = event.key === 'ArrowLeft' ? -1 : 1;
			showSlide(carousel, Number(carousel.dataset.index ?? 0) + direction);
		});
	});

	const closeAll = (except?: HTMLButtonElement) => {
		markers.forEach((marker) => {
			if (marker === except) return;
			marker.setAttribute('aria-expanded', 'false');
			const panel = document.getElementById(
				marker.getAttribute('aria-controls') ?? '',
			);
			if (panel) {
				panel.hidden = true;
				showSlide(panel, 0, false);
			}
		});
		if (!except && placePicker) placePicker.value = '';
	};

	const setClusterIsolation = (activeCluster?: MapCluster) => {
		const activeMarkers = new Set(
			activeCluster?.members.map(({ marker }) => marker) ?? [],
		);
		mapFrame?.classList.toggle('has-expanded-cluster', Boolean(activeCluster));
		markers.forEach((marker) => {
			marker.disabled = Boolean(activeCluster && !activeMarkers.has(marker));
		});
		clusters.forEach((cluster) => {
			cluster.button.disabled = Boolean(
				activeCluster && cluster !== activeCluster,
			);
		});
	};

	const collapseCluster = (cluster: MapCluster) => {
		cluster.expanded = false;
		cluster.button.textContent = String(cluster.members.length);
		cluster.button.setAttribute(
			'aria-label',
			`${cluster.members.length} nearby places: ${cluster.names}. Expand markers.`,
		);
		cluster.button.setAttribute('aria-expanded', 'false');
		cluster.members.forEach(({ marker, place }) => {
			place.classList.remove('is-spiderfied');
			place.style.removeProperty('--spider-offset-x');
			place.style.removeProperty('--spider-offset-y');
			marker.setAttribute('aria-hidden', 'true');
			marker.tabIndex = -1;
		});
		cluster.lines.forEach((line) => line.remove());
		cluster.lines = [];
		if (!clusters.some((candidate) => candidate.expanded))
			setClusterIsolation();
	};

	const collapseClusters = (except?: MapCluster) => {
		clusters.forEach((cluster) => {
			if (cluster !== except && cluster.expanded) collapseCluster(cluster);
		});
	};

	const expandCluster = (cluster: MapCluster) => {
		if (cluster.expanded || !clusterLines) return;

		closeAll();
		collapseClusters(cluster);
		cluster.expanded = true;
		setClusterIsolation(cluster);
		cluster.button.textContent = '×';
		cluster.button.setAttribute(
			'aria-label',
			`Collapse nearby places: ${cluster.names}.`,
		);
		cluster.button.setAttribute('aria-expanded', 'true');

		const markerSpacing = 32;
		const radius = Math.max(
			30,
			(cluster.members.length * markerSpacing) / (2 * Math.PI),
		);
		cluster.members.forEach(({ marker, place, x, y }, index) => {
			const angle =
				cluster.members.length === 2
					? index * Math.PI
					: -Math.PI / 2 + (index * 2 * Math.PI) / cluster.members.length;
			const targetX = cluster.x + Math.cos(angle) * radius;
			const targetY = cluster.y + Math.sin(angle) * radius;

			place.style.setProperty('--spider-offset-x', `${targetX - x}px`);
			place.style.setProperty('--spider-offset-y', `${targetY - y}px`);
			place.classList.add('is-spiderfied');
			marker.removeAttribute('aria-hidden');
			marker.tabIndex = 0;

			const line = document.createElementNS(
				'http://www.w3.org/2000/svg',
				'line',
			);
			line.setAttribute('x1', String(x));
			line.setAttribute('y1', String(y));
			line.setAttribute('x2', String(targetX));
			line.setAttribute('y2', String(targetY));
			clusterLines.append(line);
			cluster.lines.push(line);
		});
	};

	const rebuildClusters = () => {
		if (!mapFrame || !clusterButtons || !clusterLines) return;

		closeAll();
		setClusterIsolation();
		clusterButtons.replaceChildren();
		clusterLines.replaceChildren();
		clusters = [];
		markerClusters.clear();

		const width = mapFrame.clientWidth;
		const height = mapFrame.clientHeight;
		clusterLines.setAttribute('viewBox', `0 0 ${width} ${height}`);

		const points = [...markers].flatMap<MarkerPoint>((marker) => {
			const place = marker.closest<HTMLElement>('.place');
			if (!place) return [];

			place.classList.remove('is-clustered', 'is-spiderfied');
			place.style.removeProperty('--spider-offset-x');
			place.style.removeProperty('--spider-offset-y');
			marker.removeAttribute('aria-hidden');
			marker.tabIndex = 0;

			const latitude = Number(place.dataset.latitude);
			const longitude = Number(place.dataset.longitude);
			return [
				{
					marker,
					place,
					x: ((longitude + 180) / 360) * width,
					y: ((90 - latitude) / 180) * height,
				},
			];
		});

		const parent = points.map((_, index) => index);
		const find = (index: number): number => {
			if (parent[index] !== index) parent[index] = find(parent[index]);
			return parent[index];
		};
		const union = (a: number, b: number) => {
			const rootA = find(a);
			const rootB = find(b);
			if (rootA !== rootB) parent[rootB] = rootA;
		};

		const clusterDistance = window.matchMedia('(pointer: coarse)').matches
			? 30
			: 24;
		for (let a = 0; a < points.length; a += 1) {
			for (let b = a + 1; b < points.length; b += 1) {
				if (
					Math.hypot(points[a].x - points[b].x, points[a].y - points[b].y) <=
					clusterDistance
				) {
					union(a, b);
				}
			}
		}

		const groups = new Map<number, MarkerPoint[]>();
		points.forEach((point, index) => {
			const root = find(index);
			groups.set(root, [...(groups.get(root) ?? []), point]);
		});

		groups.forEach((members) => {
			if (members.length < 2) return;

			const x =
				members.reduce((sum, member) => sum + member.x, 0) / members.length;
			const y =
				members.reduce((sum, member) => sum + member.y, 0) / members.length;
			const names = members
				.map(({ marker }) => marker.dataset.placeName)
				.filter(Boolean)
				.join(', ');
			const button = document.createElement('button');
			button.className = 'cluster-button';
			button.type = 'button';
			button.textContent = String(members.length);
			button.style.left = `${x}px`;
			button.style.top = `${y}px`;
			button.setAttribute(
				'aria-label',
				`${members.length} nearby places: ${names}. Expand markers.`,
			);
			button.setAttribute('aria-expanded', 'false');
			button.setAttribute(
				'aria-controls',
				members
					.map(({ marker }) => marker.getAttribute('aria-controls'))
					.filter(Boolean)
					.join(' '),
			);
			clusterButtons.append(button);

			const cluster: MapCluster = {
				members,
				button,
				lines: [],
				names,
				x,
				y,
				expanded: false,
			};
			clusters.push(cluster);
			members.forEach(({ marker, place }) => {
				markerClusters.set(marker, cluster);
				place.classList.add('is-clustered');
				marker.setAttribute('aria-hidden', 'true');
				marker.tabIndex = -1;
			});

			button.addEventListener('click', () => {
				if (cluster.expanded) {
					closeAll();
					collapseCluster(cluster);
				} else {
					expandCluster(cluster);
				}
			});
		});
	};

	const openMarker = (marker: HTMLButtonElement, focusPanel = false) => {
		const cluster = markerClusters.get(marker);
		if (cluster) expandCluster(cluster);
		else collapseClusters();
		closeAll(marker);
		marker.setAttribute('aria-expanded', 'true');
		const panel = document.getElementById(
			marker.getAttribute('aria-controls') ?? '',
		);
		if (panel) {
			showSlide(panel, Number(panel.dataset.index ?? 0));
			panel.hidden = false;
			if (focusPanel) requestAnimationFrame(() => panel.focus());
		}
		if (placePicker)
			placePicker.value = marker.getAttribute('aria-controls') ?? '';
	};

	markers.forEach((marker) => {
		const panel = document.getElementById(
			marker.getAttribute('aria-controls') ?? '',
		);
		const warmMarker = (priority: 'high' | 'low') => {
			if (panel)
				requestSlide(panel, Number(panel.dataset.index ?? 0), priority);
		};

		marker.addEventListener('pointerenter', () => warmMarker('low'));
		marker.addEventListener('focus', () => warmMarker('low'));
		marker.addEventListener('pointerdown', () => warmMarker('high'));
		marker.addEventListener('click', () => {
			if (marker.getAttribute('aria-expanded') === 'true') closeAll();
			else openMarker(marker);
		});
	});

	if (mapFrame) {
		const connection = (
			navigator as Navigator & { connection?: { saveData?: boolean } }
		).connection;
		if (!connection?.saveData) {
			const mapObserver = new IntersectionObserver(
				(entries) => {
					if (!entries.some((entry) => entry.isIntersecting)) return;
					mapObserver.disconnect();
					window.setTimeout(() => {
						carousels.forEach((carousel) => requestSlide(carousel, 0, 'low'));
					}, 250);
				},
				{ rootMargin: '160px' },
			);
			mapObserver.observe(mapFrame);
		}
	}

	placePicker?.addEventListener('change', () => {
		const marker = [...markers].find(
			(item) => item.getAttribute('aria-controls') === placePicker.value,
		);
		if (marker) openMarker(marker, true);
		else closeAll();
	});

	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Element)) return;
		if (!event.target.closest('.place, .place-picker, .cluster-button')) {
			closeAll();
			collapseClusters();
		}
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			closeAll();
			collapseClusters();
		}
	});

	let resizeFrame = 0;
	new ResizeObserver(() => {
		cancelAnimationFrame(resizeFrame);
		resizeFrame = requestAnimationFrame(rebuildClusters);
	}).observe(mapFrame!);
</script>

<style>
	.map-toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.8rem;
	}

	.map-instructions {
		margin: 0;
		color: var(--muted);
		font-size: 0.78rem;
	}

	.place-picker {
		display: flex;
		flex: none;
		align-items: center;
		gap: 0.5rem;
		color: var(--muted);
		font-size: 0.72rem;
	}

	.place-picker select {
		max-width: 12rem;
		padding: 0.32rem 0.5rem;
		border: 1px solid var(--line);
		border-radius: 0;
		color: var(--ink);
		background: var(--paper);
		font: inherit;
		font-size: 0.75rem;
	}

	.map-caption {
		max-width: 38rem;
		margin: 0.75rem 0 0;
		color: var(--muted);
		font-size: 0.72rem;
		line-height: 1.55;
	}

	.map-caption a {
		color: inherit;
	}

	.map-frame {
		position: relative;
		width: 100%;
