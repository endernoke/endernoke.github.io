---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="figure">
	<Image
		src={src}
		alt={alt}
		widths={[480, 680, 1024, 1360]}
		sizes="(max-width: 712px) calc(100vw - 32px), 680px"
		loading="lazy"
	/>
	{
		(caption || Astro.slots.has('default')) && (
			<figcaption>
				{caption}
				<slot />
			</figcaption>
		)
	}
</figure>

<style>
	.figure {
		display: flex;
		flex-direction: column;
		gap: 10px;
		margin-block: 14px;
	}

	.figure :global(img) {
		width: 100%;
		border-radius: 6px;
	}

	figcaption {
		color: var(--muted);
		font-family: var(--sans);
		font-size: 14px;
		line-height: 1.5;
	}
</style>
