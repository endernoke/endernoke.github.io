---
import { getCollection } from 'astro:content';
import EntryList from '../../components/EntryList.astro';
import Layout from '../../layouts/Layout.astro';

const posts = (
	await getCollection(
		'entries',
		({ data }) => data.kind === 'blog' && !data.draft,
	)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
	title="Blog - James Zheng"
	description="James' thoughts on technology and creation, as well as technical sharings."
>
	<div class="index-shell">
		<header class="page-heading">
			<h1>Blog</h1>
			<p>Thoughts on technology and creation.</p>
		</header>
		{
			posts.length > 0 ? (
				<EntryList entries={posts} layout="grid" />
			) : (
				<p class="empty-state">
					I hope to start writing here soon about reflections on technology, my
					encounters and stories, as well as technical sharings. Stay tuned. For
					the time being, you can browse my <a href="/projects">projects</a> or{' '}
					<a href="/misc">miscellaneous</a> page.
				</p>
			)
		}
	</div>
</Layout>

<style>
	.empty-state {
		max-width: 38rem;
		margin: 0;
		font-size: clamp(1.05rem, 2.5vw, 1.17rem);
		line-height: 1.72;
	}
</style>
