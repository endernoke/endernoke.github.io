---
import IndexLayout from '../layouts/IndexLayout.astro';
import { entryUrl, getPosts, getProjects } from '../lib/site';

const entries = [...(await getPosts()), ...(await getProjects())];
const destinations = [
	'/',
	'/projects',
	'/writing',
	'/travels',
	...entries.map(entryUrl),
];
---

<IndexLayout title="Page not found" description="This page could not be found.">
	<div class="page-head">
		<h1 class="page-title">Page not found.</h1>
		<p class="page-intro">
			This page isn’t here. It may have moved, been removed, or never existed.
		</p>
		<p class="page-intro">
			The <a href="https://www.ft.com/404">Financial Times</a> might have some economic
			theories about what happened.
		</p>
	</div>
	<nav class="options" aria-label="Where to next">
		<a href="/">Go home</a>
		<a
			href="/"
			data-random-link
			data-destinations={JSON.stringify(destinations)}>Random page</a
		>
	</nav>
</IndexLayout>

<script>
	const link = document.querySelector<HTMLAnchorElement>('[data-random-link]');
	if (link) {
		const list: string[] = JSON.parse(link.dataset.destinations ?? '[]');
		const pick = list[Math.floor(Math.random() * list.length)];
		if (pick) link.href = pick;
	}
</script>

<style>
	.options {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 24px;
		font-size: 15px;
	}
</style>
