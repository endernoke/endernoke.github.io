---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import IndexLayout from '../layouts/IndexLayout.astro';
import PostRow from '../components/PostRow.astro';
import ProjectRow from '../components/ProjectRow.astro';
import SectionLabel from '../components/SectionLabel.astro';
import { getPosts, getProjects, SITE } from '../lib/site';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('Homepage content was not found.');
const { Content } = await render(home);
const { portrait, portraitAlt, portraitCaption } = home.data;

const posts = (await getPosts()).slice(0, 3);
const featured = (await getProjects())
	.filter((p) => p.data.featured)
	.slice(0, 4);

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: SITE.name,
	url: SITE.url,
	email: `mailto:${SITE.email}`,
	sameAs: [SITE.github, SITE.linkedin, SITE.x],
	affiliation: {
		'@type': 'CollegeOrUniversity',
		name: 'University of Hong Kong',
		url: 'https://www.hku.hk',
	},
};
---

<IndexLayout
	description={home.data.description}
	seed="home"
	jsonLd={jsonLd}
	gap={72}
	mainGap={72}
>
	<section class="intro" aria-labelledby="intro-heading">
		{
			portrait && (
				<figure class="portrait">
					<Image
						src={portrait}
						alt={portraitAlt ?? ''}
						width={168}
						height={210}
						widths={[112, 168, 224, 336, 504]}
						sizes="(max-width: 639px) 112px, 168px"
						fetchpriority="high"
						loading="eager"
					/>
					{portraitCaption && <figcaption>{portraitCaption}</figcaption>}
				</figure>
			)
		}
		<h1 class="page-title" id="intro-heading">Hello, I’m James.</h1>
		<div class="intro-copy">
			<Content />
			<p class="contact">
				Say hello on <a
					href={SITE.github}
					data-umami-event="social-github-click">GitHub</a
				>, <a href={SITE.linkedin} data-umami-event="social-linkedin-click"
					>LinkedIn</a
				> or <a href={SITE.x} data-umami-event="social-x-click">X</a>, or write
				to <a
					href={`mailto:${SITE.email}`}
					data-umami-event="contact-email-click">{SITE.email}</a
				>.
			</p>
		</div>
		<span class="sentinel" data-bio-end aria-hidden="true"></span>
	</section>

	{
		posts.length > 0 && (
			<section class="section" aria-labelledby="h-writing">
				<SectionLabel id="h-writing">Writing</SectionLabel>
				<ol class="plain-list rows">
					{posts.map((post) => (
						<PostRow post={post} />
					))}
				</ol>
				<a class="more-link" href="/writing">
					All writing
				</a>
			</section>
		)
	}

	<section class="section" aria-labelledby="h-made">
		<SectionLabel id="h-made">Things I’ve made</SectionLabel>
		<ul class="plain-list made">
			{
				featured.map((project) => (
					<ProjectRow project={project} variant="home" />
				))
			}
		</ul>
		<a class="more-link" href="/projects">All projects</a>
	</section>
</IndexLayout>

<script>
	import { trackEvent } from '../scripts/analytics';

	// bio-end-reached: the end of the intro stayed in view for two seconds.
	const bioEnd = document.querySelector<HTMLElement>('[data-bio-end]');
	if (bioEnd) {
		let visible = false;
		let timer = 0;
		let tracked = false;

		const stop = () => {
			window.clearTimeout(timer);
			timer = 0;
		};

		const start = () => {
			if (
				tracked ||
				!visible ||
				document.visibilityState !== 'visible' ||
				timer
			)
				return;
			timer = window.setTimeout(() => {
				timer = 0;
				if (tracked || !visible || document.visibilityState !== 'visible')
					return;
				tracked = true;
				trackEvent('bio-end-reached');
				observer.disconnect();
			}, 2000);
		};

		const observer = new IntersectionObserver(
			([entry]) => {
				visible = entry.isIntersecting;
				if (visible) start();
				else stop();
			},
			{ threshold: 1 },
		);

		observer.observe(bioEnd);
		document.addEventListener('visibilitychange', () => {
			if (document.visibilityState === 'visible') start();
			else stop();
		});
		window.addEventListener(
			'pagehide',
			() => {
				stop();
				observer.disconnect();
			},
			{ once: true },
		);
	}
</script>

<style>
	/* A short intro still fills the first screen, so the Writing and Projects
	   sections never peek in above the fold. 200px = 56px top padding + 72px
	   header gap + 72px section gap; the header's own height is left as slack
	   so a header that wraps on narrow screens can't pull them back up. lvh
	   (toolbars hidden) keeps them below the fold when mobile toolbars retract. */
	.intro {
		display: flow-root;
		min-height: calc(100vh - 200px);
		min-height: calc(100lvh - 200px);
	}

	.portrait {
		float: right;
		display: flex;
		flex-direction: column;
		gap: 8px;
		width: 168px;
		max-width: 38%;
		margin: 6px 0 16px 36px;
	}

	.portrait :global(img) {
		width: 100%;
		aspect-ratio: 4 / 5;
		border-radius: 4px;
		background: var(--placeholder);
		object-fit: cover;
	}

	.portrait figcaption {
		color: var(--muted);
		font-family: var(--mono);
		font-size: 12px;
		line-height: 1.4;
	}

	h1 {
		margin-bottom: 24px;
	}

	.intro-copy :global(p) {
		margin-bottom: 18px;
	}

	.intro-copy .contact {
		margin-bottom: 0;
		color: var(--ink-2);
	}

	.contact a[href^='mailto:'] {
		user-select: text;
	}

	.sentinel {
		display: block;
		width: 1px;
		height: 1px;
	}

	.rows {
		border-bottom: 1px solid var(--line);
	}

	.made {
		display: flex;
		flex-direction: column;
		gap: 22px;
	}

	@media (max-width: 639.98px) {
		.portrait {
			width: 112px;
			margin-left: 20px;
		}
	}
</style>
