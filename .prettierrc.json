{
  "plugins": ["prettier-plugin-astro"],
  "singleQuote": true,
  "trailingComma": "all",
  "overrides": [
    {
      "files": ["*.astro", "*.css", "*.js", "*.mjs", "*.ts"],
      "options": {
        "useTabs": true
      }
    },
    {
      "files": "*.astro",
      "options": {
        "parser": "astro"
      }
    }
  ]
}
